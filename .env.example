# Google AI Studio API Key (デフォルト推奨)
GEMINI_API_KEY=your-gemini-api-key

# オプション: モデル指定（未指定時はデフォルトモデルが使用されます）
# GEMINI_FLASH_MODEL=gemini-3.7-flash
# GEMINI_3_8_FLASH_MODEL=gemini-3.8-flash
# GEMINI_3_5_FLASH_LITE_MODEL=gemini-3.5-flash-lite
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview


# オプション: Vertex AI を使用する場合
# GEMINI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

